# MODAVIS Ontology Network 0.1.0 redirects.
# Submit only after every HTTPS destination has been deployed and verified.
# Versioned targets are immutable after publication.

Options -MultiViews
RewriteEngine On

# Network landing page.
RewriteRule ^$ https://modavis-project.github.io/modavis-ontology-network/index.html [R=303,L]

# Aggregate ontology IRI and immutable aggregate version IRI.
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^ontology(?:/0\.1\.0)?/?$ https://modavis-project.github.io/modavis-ontology-network/ontology/0.1.0/ontology.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^ontology(?:/0\.1\.0)?/?$ https://modavis-project.github.io/modavis-ontology-network/ontology/0.1.0/ontology.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^ontology(?:/0\.1\.0)?/?$ https://modavis-project.github.io/modavis-ontology-network/ontology/0.1.0/ontology.rdf [R=303,L]
RewriteCond %{HTTP_ACCEPT} ^$ [OR]
RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} text/html [NC]
RewriteRule ^ontology(?:/0\.1\.0)?/?$ https://modavis-project.github.io/modavis-ontology-network/ontology/0.1.0/index.html [R=303,L]
RewriteRule ^ontology(?:/0\.1\.0)?/?$ - [R=406,L]

# Ontology module IRIs. Stable and 0.1.0 version IRIs negotiate to the same
# immutable 0.1.0 graph; future stable routes may advance independently.
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^ontology/(assertion|audio|context|core|events|evidence|heritage|instrument|media|midi|organ|provenance|virtual-instrument)(?:/0\.1\.0)?/?$ https://modavis-project.github.io/modavis-ontology-network/ontology/$1/0.1.0/$1.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^ontology/(assertion|audio|context|core|events|evidence|heritage|instrument|media|midi|organ|provenance|virtual-instrument)(?:/0\.1\.0)?/?$ https://modavis-project.github.io/modavis-ontology-network/ontology/$1/0.1.0/$1.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^ontology/(assertion|audio|context|core|events|evidence|heritage|instrument|media|midi|organ|provenance|virtual-instrument)(?:/0\.1\.0)?/?$ https://modavis-project.github.io/modavis-ontology-network/ontology/$1/0.1.0/$1.rdf [R=303,L]
RewriteCond %{HTTP_ACCEPT} ^$ [OR]
RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} text/html [NC]
RewriteRule ^ontology/(assertion|audio|context|core|events|evidence|heritage|instrument|media|midi|organ|provenance|virtual-instrument)(?:/0\.1\.0)?/?$ https://modavis-project.github.io/modavis-ontology-network/ontology/$1/0.1.0/index.html [R=303,L]
RewriteRule ^ontology/(assertion|audio|context|core|events|evidence|heritage|instrument|media|midi|organ|provenance|virtual-instrument)(?:/0\.1\.0)?/?$ - [R=406,L]

# The combined controlled vocabulary and enumerated stable scheme/concept IRIs.
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^vocab(?:/0\.1\.0)?/?$ https://modavis-project.github.io/modavis-ontology-network/vocab/0.1.0/vocab.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^vocab(?:/0\.1\.0)?/?$ https://modavis-project.github.io/modavis-ontology-network/vocab/0.1.0/vocab.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^vocab(?:/0\.1\.0)?/?$ https://modavis-project.github.io/modavis-ontology-network/vocab/0.1.0/vocab.rdf [R=303,L]
RewriteCond %{HTTP_ACCEPT} ^$ [OR]
RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} text/html [NC]
RewriteRule ^vocab(?:/0\.1\.0)?/?$ https://modavis-project.github.io/modavis-ontology-network/vocab/0.1.0/index.html [R=303,L]
RewriteRule ^vocab(?:/0\.1\.0)?/?$ - [R=406,L]

# Every term route below is generated from the published SKOS graph. Unknown
# schemes, concepts, and cross-scheme pairings fall through to the 404 rule.
# Enumerated concepts: assertion-predicate/has-builder assertion-status/accepted assertion-status/draft assertion-status/rejected assertion-status/superseded
# Enumerated concepts: checksum-algorithm/sha-256 compatibility-status/compatible compatibility-status/compatible-with-limitations compatibility-status/incompatible compatibility-status/indeterminate
# Enumerated concepts: component-membership-type/connected-to component-membership-type/controlled-by component-membership-type/member-of-collection component-membership-type/structural-part
# Enumerated concepts: event-type/construction event-type/digitization event-type/measurement event-type/recording event-type/relocation event-type/restoration
# Enumerated concepts: evidence-role/contextual evidence-role/opposing evidence-role/supporting
# Enumerated concepts: functional-role/action-mechanism functional-role/playing-interface functional-role/resonator functional-role/selector functional-role/sound-generator functional-role/sound-initiator functional-role/sound-modulator
# Enumerated concepts: heritage-recognition-status/declined heritage-recognition-status/proposed heritage-recognition-status/recognized heritage-recognition-status/withdrawn
# Enumerated concepts: instrument-type/piano instrument-type/pipe-organ instrument-type/violin instrument-type/virtual-musical-instrument
# Enumerated concepts: representation-status/authored representation-status/captured representation-status/creative representation-status/hybrid representation-status/inferred representation-status/learned representation-status/measured representation-status/processed representation-status/reconstructed representation-status/simulated
# Enumerated concepts: virtual-instrument-production-method/algorithmic-synthesis virtual-instrument-production-method/convolution-based virtual-instrument-production-method/hybrid virtual-instrument-production-method/physical-modeling virtual-instrument-production-method/sampled
# Enumerated concepts: virtual-instrument-source-relation/composite-source virtual-instrument-source-relation/historical-reconstruction virtual-instrument-source-relation/inspired-by virtual-instrument-source-relation/modeled-after virtual-instrument-source-relation/sampled-from
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^vocab/(assertion-predicate/has-builder|assertion-status/(?:accepted|draft|rejected|superseded)|checksum-algorithm/sha-256|compatibility-status/(?:compatible|compatible-with-limitations|incompatible|indeterminate)|component-membership-type/(?:connected-to|controlled-by|member-of-collection|structural-part)|event-type/(?:construction|digitization|measurement|recording|relocation|restoration)|evidence-role/(?:contextual|opposing|supporting)|functional-role/(?:action-mechanism|playing-interface|resonator|selector|sound-generator|sound-initiator|sound-modulator)|heritage-recognition-status/(?:declined|proposed|recognized|withdrawn)|instrument-type/(?:piano|pipe-organ|violin|virtual-musical-instrument)|representation-status/(?:authored|captured|creative|hybrid|inferred|learned|measured|processed|reconstructed|simulated)|virtual-instrument-production-method/(?:algorithmic-synthesis|convolution-based|hybrid|physical-modeling|sampled)|virtual-instrument-source-relation/(?:composite-source|historical-reconstruction|inspired-by|modeled-after|sampled-from))/?$ https://modavis-project.github.io/modavis-ontology-network/vocab/0.1.0/vocab.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^vocab/(assertion-predicate/has-builder|assertion-status/(?:accepted|draft|rejected|superseded)|checksum-algorithm/sha-256|compatibility-status/(?:compatible|compatible-with-limitations|incompatible|indeterminate)|component-membership-type/(?:connected-to|controlled-by|member-of-collection|structural-part)|event-type/(?:construction|digitization|measurement|recording|relocation|restoration)|evidence-role/(?:contextual|opposing|supporting)|functional-role/(?:action-mechanism|playing-interface|resonator|selector|sound-generator|sound-initiator|sound-modulator)|heritage-recognition-status/(?:declined|proposed|recognized|withdrawn)|instrument-type/(?:piano|pipe-organ|violin|virtual-musical-instrument)|representation-status/(?:authored|captured|creative|hybrid|inferred|learned|measured|processed|reconstructed|simulated)|virtual-instrument-production-method/(?:algorithmic-synthesis|convolution-based|hybrid|physical-modeling|sampled)|virtual-instrument-source-relation/(?:composite-source|historical-reconstruction|inspired-by|modeled-after|sampled-from))/?$ https://modavis-project.github.io/modavis-ontology-network/vocab/0.1.0/vocab.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^vocab/(assertion-predicate/has-builder|assertion-status/(?:accepted|draft|rejected|superseded)|checksum-algorithm/sha-256|compatibility-status/(?:compatible|compatible-with-limitations|incompatible|indeterminate)|component-membership-type/(?:connected-to|controlled-by|member-of-collection|structural-part)|event-type/(?:construction|digitization|measurement|recording|relocation|restoration)|evidence-role/(?:contextual|opposing|supporting)|functional-role/(?:action-mechanism|playing-interface|resonator|selector|sound-generator|sound-initiator|sound-modulator)|heritage-recognition-status/(?:declined|proposed|recognized|withdrawn)|instrument-type/(?:piano|pipe-organ|violin|virtual-musical-instrument)|representation-status/(?:authored|captured|creative|hybrid|inferred|learned|measured|processed|reconstructed|simulated)|virtual-instrument-production-method/(?:algorithmic-synthesis|convolution-based|hybrid|physical-modeling|sampled)|virtual-instrument-source-relation/(?:composite-source|historical-reconstruction|inspired-by|modeled-after|sampled-from))/?$ https://modavis-project.github.io/modavis-ontology-network/vocab/0.1.0/vocab.rdf [R=303,L]
RewriteCond %{HTTP_ACCEPT} ^$ [OR]
RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} text/html [NC]
RewriteRule ^vocab/(assertion-predicate/has-builder|assertion-status/(?:accepted|draft|rejected|superseded)|checksum-algorithm/sha-256|compatibility-status/(?:compatible|compatible-with-limitations|incompatible|indeterminate)|component-membership-type/(?:connected-to|controlled-by|member-of-collection|structural-part)|event-type/(?:construction|digitization|measurement|recording|relocation|restoration)|evidence-role/(?:contextual|opposing|supporting)|functional-role/(?:action-mechanism|playing-interface|resonator|selector|sound-generator|sound-initiator|sound-modulator)|heritage-recognition-status/(?:declined|proposed|recognized|withdrawn)|instrument-type/(?:piano|pipe-organ|violin|virtual-musical-instrument)|representation-status/(?:authored|captured|creative|hybrid|inferred|learned|measured|processed|reconstructed|simulated)|virtual-instrument-production-method/(?:algorithmic-synthesis|convolution-based|hybrid|physical-modeling|sampled)|virtual-instrument-source-relation/(?:composite-source|historical-reconstruction|inspired-by|modeled-after|sampled-from))/?$ https://modavis-project.github.io/modavis-ontology-network/vocab/0.1.0/index.html#$1 [R=303,L,NE]
RewriteRule ^vocab/(assertion-predicate/has-builder|assertion-status/(?:accepted|draft|rejected|superseded)|checksum-algorithm/sha-256|compatibility-status/(?:compatible|compatible-with-limitations|incompatible|indeterminate)|component-membership-type/(?:connected-to|controlled-by|member-of-collection|structural-part)|event-type/(?:construction|digitization|measurement|recording|relocation|restoration)|evidence-role/(?:contextual|opposing|supporting)|functional-role/(?:action-mechanism|playing-interface|resonator|selector|sound-generator|sound-initiator|sound-modulator)|heritage-recognition-status/(?:declined|proposed|recognized|withdrawn)|instrument-type/(?:piano|pipe-organ|violin|virtual-musical-instrument)|representation-status/(?:authored|captured|creative|hybrid|inferred|learned|measured|processed|reconstructed|simulated)|virtual-instrument-production-method/(?:algorithmic-synthesis|convolution-based|hybrid|physical-modeling|sampled)|virtual-instrument-source-relation/(?:composite-source|historical-reconstruction|inspired-by|modeled-after|sampled-from))/?$ - [R=406,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^vocab/(assertion-predicate|assertion-status|checksum-algorithm|compatibility-status|component-membership-type|event-type|evidence-role|functional-role|heritage-recognition-status|instrument-type|representation-status|virtual-instrument-production-method|virtual-instrument-source-relation)/?$ https://modavis-project.github.io/modavis-ontology-network/vocab/0.1.0/vocab.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^vocab/(assertion-predicate|assertion-status|checksum-algorithm|compatibility-status|component-membership-type|event-type|evidence-role|functional-role|heritage-recognition-status|instrument-type|representation-status|virtual-instrument-production-method|virtual-instrument-source-relation)/?$ https://modavis-project.github.io/modavis-ontology-network/vocab/0.1.0/vocab.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^vocab/(assertion-predicate|assertion-status|checksum-algorithm|compatibility-status|component-membership-type|event-type|evidence-role|functional-role|heritage-recognition-status|instrument-type|representation-status|virtual-instrument-production-method|virtual-instrument-source-relation)/?$ https://modavis-project.github.io/modavis-ontology-network/vocab/0.1.0/vocab.rdf [R=303,L]
RewriteCond %{HTTP_ACCEPT} ^$ [OR]
RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} text/html [NC]
RewriteRule ^vocab/(assertion-predicate|assertion-status|checksum-algorithm|compatibility-status|component-membership-type|event-type|evidence-role|functional-role|heritage-recognition-status|instrument-type|representation-status|virtual-instrument-production-method|virtual-instrument-source-relation)/?$ https://modavis-project.github.io/modavis-ontology-network/vocab/0.1.0/index.html#$1 [R=303,L,NE]
RewriteRule ^vocab/(assertion-predicate|assertion-status|checksum-algorithm|compatibility-status|component-membership-type|event-type|evidence-role|functional-role|heritage-recognition-status|instrument-type|representation-status|virtual-instrument-production-method|virtual-instrument-source-relation)/?$ - [R=406,L]

# Versioned JSON-LD context.
RewriteRule ^context/0\.1\.0/?$ https://modavis-project.github.io/modavis-ontology-network/context/0.1.0/context.jsonld [R=303,L]

# Versioned SHACL profiles.
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^shapes/(exchange|publication)/0\.1\.0/?$ https://modavis-project.github.io/modavis-ontology-network/shapes/$1/0.1.0/shapes.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^shapes/(exchange|publication)/0\.1\.0/?$ https://modavis-project.github.io/modavis-ontology-network/shapes/$1/0.1.0/shapes.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^shapes/(exchange|publication)/0\.1\.0/?$ https://modavis-project.github.io/modavis-ontology-network/shapes/$1/0.1.0/shapes.rdf [R=303,L]
RewriteCond %{HTTP_ACCEPT} ^$ [OR]
RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} text/html [NC]
RewriteRule ^shapes/(exchange|publication)/0\.1\.0/?$ https://modavis-project.github.io/modavis-ontology-network/shapes/$1/0.1.0/index.html [R=303,L]
RewriteRule ^shapes/(exchange|publication)/0\.1\.0/?$ - [R=406,L]

# Release catalog and manifest.
RewriteCond %{HTTP_ACCEPT} application/ld\+json [NC]
RewriteRule ^release/0\.1\.0/?$ https://modavis-project.github.io/modavis-ontology-network/release/0.1.0/catalog.jsonld [R=303,L]
RewriteCond %{HTTP_ACCEPT} text/turtle [NC]
RewriteRule ^release/0\.1\.0/?$ https://modavis-project.github.io/modavis-ontology-network/release/0.1.0/catalog.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [NC]
RewriteRule ^release/0\.1\.0/?$ https://modavis-project.github.io/modavis-ontology-network/release/0.1.0/catalog.rdf [R=303,L]
RewriteCond %{HTTP_ACCEPT} ^$ [OR]
RewriteCond %{HTTP_ACCEPT} \*/\* [OR]
RewriteCond %{HTTP_ACCEPT} text/html [NC]
RewriteRule ^release/0\.1\.0/?$ https://modavis-project.github.io/modavis-ontology-network/release/0.1.0/index.html [R=303,L]
RewriteRule ^release/0\.1\.0/?$ - [R=406,L]

# Explicitly reject unknown versions rather than silently serving latest.
RewriteRule ^(?:ontology|vocab|context|shapes|alignment|release)/.*$ - [R=404,L]
